# Plantilla de variables de entorno. Copiar a `.env` y rellenar.
# El `.env` real está gitignored: NUNCA commitees valores reales.
# Prefijo CHURN_ (ver src/churn_agent/config.py).

# --- Reproducibilidad ---
CHURN_RANDOM_SEED=42

# --- Rutas de datos (opcional; por defecto data/raw y data/processed) ---
# CHURN_DATA_RAW_DIR=data/raw
# CHURN_DATA_PROCESSED_DIR=data/processed

# --- LLM (requerido desde Fase 3) ---
ANTHROPIC_API_KEY=sk-ant-...        # clave real en .env (nunca commitear)
# CHURN_LLM_MODEL=claude-haiku-4-5-20251001   # modelo por defecto

# --- Human-in-the-loop ---
# CHURN_HITL_EV_THRESHOLD=300.0     # EV mínimo (MXN) para requerir aprobación humana
