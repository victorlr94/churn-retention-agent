# Secretos y entorno
.env
.env.*
!.env.example

# Datos (se obtienen con scripts/download_data.py; nunca se commitea el CSV)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/checksums.txt

# Demo fixtures (sample pequeño commiteado; ver ADR-0008)
!data/sample/
!data/sample/*

# Modelos y artefactos entrenados
*.pkl
*.joblib
*.gguf
models/*
!models/.gitkeep
# Demo model (commiteado; ver ADR-0008)
!models/demo/
!models/demo/*.pkl

# Tracking de experimentos
mlruns/

# Resultados de evaluación (conservar solo la baseline)
eval/results/*
!eval/results/baseline.json

# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# Notebooks (limpiar salidas con nbstripout antes de commit)
.ipynb_checkpoints/

# Logs de observabilidad (sesiones del agente; gitignoreados)
logs/*
!logs/.gitkeep

# IDE / SO
.vscode/
.idea/
.DS_Store
Thumbs.db
